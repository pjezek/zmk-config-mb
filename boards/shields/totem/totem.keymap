			bindings = <
// ╷           ╷           ╷           ╷           ╷           ╷           ╷   ╷           ╷           ╷           ╷           ╷           ╷           ╷

                &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP    &mkp LCLK &none   &kp LS(N8)  &kp KP_N7   &kp KP_N8   &kp KP_N9   &kp LS(EQUAL)
                &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp RCLK &none   &kp KP_DOT  &kp KP_N4   &kp KP_N5   &kp KP_N6   &kp MINUS
      &none     &none          &none          &none           &mkp MCLK &none   &kp KP_N0   &kp KP_N1   &kp KP_N2   &kp KP_N3 &kp EQUAL &kp SLASH
                                              &none           &none     &to 0   &none       &kp ENTER   &none
        	>;
    	};

